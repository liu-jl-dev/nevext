{
    // ============================================================ C++ 格式化
    // 风格的本体在 cpp/.clang-format，随仓库走；这里只管「用哪个工具、什么时候用」。
    // 原来这两条写在用户级 settings.json 里，会波及所有工程，搬到这儿就只对本项目生效。
    "C_Cpp.clang_format_style": "file",
    "C_Cpp.default.cppStandard": "c++20",

    "[cpp]": {
        "editor.defaultFormatter": "ms-vscode.cpptools",
        "editor.formatOnSave": true,
        "editor.tabSize": 2,
        "editor.insertSpaces": true,
        "files.trimTrailingWhitespace": true
    },
    "[c]": {
        "editor.defaultFormatter": "ms-vscode.cpptools",
        "editor.formatOnSave": true,
        "editor.tabSize": 2,
        "editor.insertSpaces": true,
        "files.trimTrailingWhitespace": true
    },

    // ============================================================ 换行与行尾
    // 仓库有 .gitattributes（* text=auto），索引里一律 LF。Windows 上 VSCode 默认
    // 存 CRLF，之前就发生过「3 个文件看起来像整文件被重写」的事，这两条把口子堵上。
    "files.eol": "\n",
    "files.insertFinalNewline": true,

    // ============================================================ CMake
    // 本仓库的 CMakeLists.txt 在 cpp/ 下，而不是仓库根
    "cmake.sourceDirectory": "${workspaceFolder}/cpp"
}
